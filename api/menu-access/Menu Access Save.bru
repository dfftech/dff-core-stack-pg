  Content-Type: application/json
}

body:json {
  {
    "menuRoleId": "ADMIN",
    "menuLinkId": "DASHBOARD",
    "read": true,
    "create": true,
    "update": true,
    "delete": false,
    "persona": "admin"
  }
}
