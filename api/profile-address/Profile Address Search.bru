meta {
  name: Profile Address Search
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/profile-address-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "profileId": "ADMIN_ADMIN",
    "limit": 10,
    "skip": 0
  }
}
