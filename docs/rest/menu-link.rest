# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = local

### 1. Menu Link Save
POST {{hosturl}}/menu-link-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "href": "/dashboard",
  "icon": "layout-dashboard",
  "menuGroupId": "ADMINISTRATOR",
  "name": "Dashboard",
  "nameLang": { "en-US": "Dashboard" },
  "priority": 1,
  "persona": "admin",
  "active": true
}

### 2. Menu Link Entity
GET {{hosturl}}/menu-link-entity/DASHBOARD
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

### 3. Menu Link Search
POST {{hosturl}}/menu-link-search
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "searchTerm": "dashboard",
  "menuGroupId": "ADMINISTRATOR",
  "persona": "admin",
  "active": true,
  "page": 1,
  "limit": 10,
  "orderBy": "priority",
  "order": "ASC"
}

### 4. Menu Link Delete
DELETE {{hosturl}}/menu-link-delete
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "id": "DASHBOARD"
}
