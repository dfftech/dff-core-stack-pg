meta {
  name: Locale Search
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/locale-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "searchTerm": "",
    "active": true,
    "limit": 20,
    "skip": 0
  }
}
