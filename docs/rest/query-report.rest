# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = local

### 1. Query Report PROFILE_REPORT
GET {{hosturl}}/query-report/PROFILE_REPORT?persona=admin
Authorization: Bearer {{authToken}}
