# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = local

### 1. Template Save
POST {{hosturl}}/template-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "id": "otp-email_en-US",
  "name": "otp-email",
  "lang": "en-US",
  "channel": "email",
  "subject": "Your one-time password",
  "content": "<div style=\"text-align:center;margin:0 0 24px\"><img src=\"{{#if data.logoUrl}}{{data.logoUrl}}{{else}}https://www.w3.org/Icons/w3c_home.png{{/if}}\" alt=\"Logo\" width=\"72\" height=\"48\" /></div><p>{{#if data.messageAbove}}{{data.messageAbove}}{{else}}Your one-time password is:{{/if}}</p><p style=\"text-align:center;font-size:32px;font-weight:700;letter-spacing:8px\">{{data.otp}}</p><p>{{#if data.messageBelow}}{{data.messageBelow}}{{else}}Do not share this code with anyone. It expires soon.{{/if}}</p>",
  "active": true
}

### 2. Template Entity
GET {{hosturl}}/template-entity/otp-email_en-US
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

### 3. Template Search
POST {{hosturl}}/template-search
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "searchTerm": "otp",
  "lang": "en-US",
  "active": true,
  "limit": 10,
  "skip": 0
}

### 4. Template Render
POST {{hosturl}}/template-render
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "templateId": "otp-email",
  "lang": "en-US",
  "data": {
    "otp": "500827",
    "logoUrl": "https://www.w3.org/Icons/w3c_home.png",
    "messageAbove": "Your one-time password is:",
    "messageBelow": "Do not share this code with anyone. It expires soon."
  }
}
