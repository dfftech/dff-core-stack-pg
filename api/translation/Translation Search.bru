meta {
  name: Translation Search Type
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/translation-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "type": "common,auth",
    "limit": 50,
    "skip": 0
  }
}
