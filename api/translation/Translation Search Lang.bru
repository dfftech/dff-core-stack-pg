meta {
  name: Translation Search Lang
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/translation-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "lang": "en-US",
    "limit": 50,
    "skip": 0
  }
}
