# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = local
@mappingId = PASTE_data.id_FROM_SAVE

### 1. Mapping Save
POST {{hosturl}}/mapping-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "type": "Test-Application",
  "entityField": "panNumber",
  "inputField": "panCardFile",
  "isRequired": true,
  "compute": ["UPPER(value)", "TRIM(value)"],
  "aiSummary": "Extract PAN number from the uploaded card image."
}

### 2. Mapping Batch Save
POST {{hosturl}}/mapping-batch-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "items": [
    {
      "type": "Test-Application",
      "entityField": "panNumber",
      "inputField": "panCardFile",
      "isRequired": true
    },
    {
      "type": "Test-Application",
      "entityField": "aadharNumber",
      "inputField": "aadharCardFile",
      "isRequired": false,
      "aiSummary": "Extract Aadhar number from the uploaded card image."
    }
  ]
}

### 3. Mapping Entity
GET {{hosturl}}/mapping-entity/{{mappingId}}
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

### 4. Mapping Search
POST {{hosturl}}/mapping-search
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "type": "Test-Application",
  "limit": 10,
  "skip": 0
}

### 5. Mapping By Type
GET {{hosturl}}/mapping-type/Test-Application
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

