meta {
  name: Site Content Search
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/site-content-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "searchTerm": "",
    "lang": "en-US",
    "limit": 10,
    "skip": 0
  }
}
