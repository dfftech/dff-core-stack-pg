meta {
  name: Menu Link Search
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/menu-link-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "searchTerm": "dashboard",
    "menuGroupId": "ADMINISTRATOR",
    "persona": "admin",
    "active": true,
    "page": 1,
    "limit": 10,
    "orderBy": "priority",
    "order": "ASC"
  }
}
