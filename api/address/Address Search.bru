meta {
  name: Address Search
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/address-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "searchTerm": "Toronto",
    "type": "bill",
    "city": "or",
    "state": "one",
    "limit": 10,
    "skip": 0
  }
}
