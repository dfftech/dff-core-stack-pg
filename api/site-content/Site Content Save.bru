meta {
  name: Site Content Save
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/site-content-save
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "type": "PRIVACY_POLICIES",
    "version": "1.0",
    "lang": "en-US",
    "content": "# Privacy Policy\n\nYour privacy matters to us.",
    "priority": 1,
    "active": true
  }
}
