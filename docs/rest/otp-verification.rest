# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = local

### 1. Otp Verification Save
POST {{hosturl}}/otp-verification-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "uid": "admin@admin.com",
  "otp": "500827",
  "isVerified": false
}

### 2. Otp Verification Search
POST {{hosturl}}/otp-verification-search
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "searchTerm": "prasad.sg@dff-software.com",
  "limit": 10,
  "skip": 0
}

### 3. Otp Verification Entity
GET {{hosturl}}/otp-verification-entity/OTP_ID
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

### 4. Verify OTP
POST {{hosturl}}/otp-verification-verify
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "id": "OTP_ID",
  "uid": "admin@admin.com",
  "otp": "123456"
}

### 5. Check OTP
GET {{hosturl}}/otp-verify-check?id=OTP_ID
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
