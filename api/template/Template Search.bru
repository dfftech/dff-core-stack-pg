meta {
  name: Template Search
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/template-search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "searchTerm": "otp",
    "lang": "en-US",
    "active": true,
    "limit": 10,
    "skip": 0
  }
}
