meta {
  name: Legal Document Save
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/legal-document-save
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  x-tenant-id: {{xTenantId}}
  Content-Type: application/json
}

body:json {
  {
    "type": "PRIVACY_POLICY",
    "version": "1.0",
    "content": {
      "title": "Privacy Policy",
      "body": "<p>Your privacy matters to us.</p>"
    },
    "priority": 1,
    "active": true
  }
}
