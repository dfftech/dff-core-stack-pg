# Environment
@hosturl = http://localhost:4000
@xTenantId = local

### Start a background CSV download and publish batches to Kafka
# `url` must be an externally reachable HTTP(S) CSV URL.
# `topic` is required and receives batch messages.
# `key` is optional; a random key is generated when omitted.
# `batchSize` is optional and defaults to 25 (allowed range: 1-1000).
# `maxBatches` optionally stops after that many emitted batches.
# `batchNo` optionally emits only the specified batch.
# The immediate response has status `DOWNLOAD_STARTED`. Kafka messages contain
# `requestId` and PROCESSING batches followed by ACTION_COMPLETED, or
# OPERATION_FAILED on error. The supplied request-id is reused in every message.
POST {{hosturl}}/csv-sse
Content-Type: application/json
request-id: product-import-request-123
x-tenant-id: {{xTenantId}}

{
  "url": "https://dtf-boltnbolt-nprd.s3.ca-central-1.amazonaws.com/local/raghu/PRODUCT_MAIN.csv",
  "topic": "test-csv-import-results",
  "key": "product-import-123",
  "batchSize": 10,
  "maxBatches": 5
}
