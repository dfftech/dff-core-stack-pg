# Environment prefix used by env() in utils/app-util.ts
BASE_NAME=CORE

# SSS / S3
CORE_S3_PUBLIC_BUCKET=
CORE_S3_PRIVATE_BUCKET=
CORE_S3_ACCESS_KEY=
CORE_S3_SECRET_KEY=
CORE_S3_REGION=us-east-1
CORE_S3_ENDPOINT=
CORE_S3_FOLDER=
CORE_S3_BASE_URL=
CORE_S3_EXPIRES=300

# SMTP
CORE_MAIL_USER=
CORE_MAIL_PASS=
CORE_MAIL_HOST=
CORE_MAIL_PORT=587
CORE_MAIL_SERVICE=outlook
CORE_MAIL_FROM_EMAIL=
CORE_MAIL_FROM_NAME=No Reply
CORE_MAIL_ENCRYPTION=tls
CORE_MAIL_SECURE=false

# Microsoft Graph mail
CORE_MAIL_GRAPH_TENANT_ID=
CORE_MAIL_GRAPH_CLIENT_ID=
CORE_MAIL_GRAPH_CLIENT_SECRET=
CORE_MAIL_GRAPH_SENDER=
