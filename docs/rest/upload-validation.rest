# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = local
@uploadValidationId = PASTE_data.id_FROM_SAVE

### 1. Upload Validation Save
POST {{hosturl}}/upload-validation-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "type": "Test-Application",
  "entityField": "panNumber",
  "fileField": "panCardFile",
  "isRequired": true,
  "compute": "UPPER(value)",
  "aiSummary": "Extract PAN number from the uploaded card image."
}

### 2. Upload Validation Batch Save
POST {{hosturl}}/upload-validation-batch-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "items": [
    {
      "type": "Test-Application",
      "entityField": "panNumber",
      "fileField": "panCardFile",
      "isRequired": true
    },
    {
      "type": "Test-Application",
      "entityField": "aadharNumber",
      "fileField": "aadharCardFile",
      "isRequired": false,
      "aiSummary": "Extract Aadhar number from the uploaded card image."
    }
  ]
}

### 3. Upload Validation Entity
GET {{hosturl}}/upload-validation-entity/{{uploadValidationId}}
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

### 4. Upload Validation Search
POST {{hosturl}}/upload-validation-search
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "type": "Test-Application",
  "limit": 10,
  "skip": 0
}

### 5. Upload Validation By Type
GET {{hosturl}}/upload-validation-type/Test-Application
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
